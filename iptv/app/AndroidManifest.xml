<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.saadharazi.shasha"
    android:versionCode="4"
    android:versionName="1.2.1">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- نفس التطبيق للتلفزيون (ريموت) والجوال (لمس) -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- المشغّل يقيس نوع الشبكة عشان يختار الجودة المناسبة -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- سيرفرات IPTV أغلبها http بدون تشفير -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/AppTheme"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:largeHeap="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustPan|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".DetailsActivity" android:exported="false" />

        <activity
            android:name=".SourceActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation"
            android:theme="@style/PlayerTheme" />
    </application>
</manifest>
